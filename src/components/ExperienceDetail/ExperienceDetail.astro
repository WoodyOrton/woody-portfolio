---
import BlockRenderer from '../../blocks/BlockRenderer.astro';
import type { Experience } from '../../utils/experience.types';

interface Props {
	experience: Experience;
}

const { experience } = Astro.props;
---

<article class="experience">
	<a class="back label" href="/#experience">All experience</a>

	<header class="head">
		<h1>{experience.role}</h1>
		<dl class="title-block">
			<div>
				<dt class="label">Organisation</dt>
				<dd>{experience.organisation}</dd>
			</div>
			<div>
				<dt class="label">Dates</dt>
				<dd>{experience.period}</dd>
			</div>
			{
				experience.location && (
					<div>
						<dt class="label">Location</dt>
						<dd>{experience.location}</dd>
					</div>
				)
			}
		</dl>
	</header>

	{
		experience.blocks.length > 0 && (
			<div class="body">
				<BlockRenderer blocks={experience.blocks} />
			</div>
		)
	}
</article>

<style>
	.experience {
		max-inline-size: var(--content-width);
		margin-inline: auto;
		padding: var(--space-l) var(--gutter) var(--space-2xl);
	}

	.back {
		display: inline-flex;
		align-items: center;
		min-block-size: var(--tap-target);
		text-decoration: none;
		color: var(--color-text-soft);
	}

	.back::before {
		content: '←';
		margin-inline-end: var(--space-2xs);
		color: var(--color-accent);
		transition: transform var(--duration-base) var(--ease-out);
	}

	.back:hover {
		color: var(--color-accent);
	}

	.back:hover::before {
		transform: translateX(-0.35em);
	}

	.head {
		display: grid;
		gap: var(--space-l);
		margin-block: var(--space-l) var(--space-xl);
		padding-block-end: var(--space-l);
		border-block-end: var(--border-hairline);
	}

	h1 {
		max-inline-size: 16ch;
		font-size: var(--step-4);
		font-weight: var(--weight-display);
		line-height: var(--leading-snug);
		letter-spacing: -0.035em;
		overflow-wrap: anywhere;
	}

	.title-block {
		display: grid;
		gap: var(--space-s);
		margin: 0;
	}

	.title-block div {
		display: grid;
		gap: var(--space-3xs);
	}

	dd {
		margin: 0;
		color: var(--color-text-soft);
	}

	.body {
		max-inline-size: var(--content-width);
	}

	@media (min-width: 56rem) {
		.head {
			grid-template-columns: 1.5fr 1fr;
			align-items: end;
			gap: var(--space-2xl);
		}
	}
</style>
