---
import type { ExperienceEntry } from '../../utils/cv.types';

interface Props {
	entries: ExperienceEntry[];
	/** Reused for the Previous jobs section, which has the same shape. */
	heading?: string;
	/** Anchor for links such as /#experience. */
	id?: string;
}

const { entries, heading = 'Experience', id = 'experience' } = Astro.props;
// The main Experience section uses the Projects-style rows; Previous jobs keeps the compact timeline.
const lead = id === 'experience';
---

{
	entries.length > 0 && (
		<section class="cv" id={id} aria-labelledby={`${id}-heading`}>
			<h2 id={`${id}-heading`} class:list={{ lead }}>{heading}</h2>
			<ol class:list={{ lead }}>
				{entries.map(({ role, organisation, period, location, description, slug }) =>
					lead ? (
						<li>
							<h3>{slug ? <a href={`/experience/${slug}`}>{role}</a> : role}</h3>
							<p class="where">{[organisation, location].filter(Boolean).join(' · ')}</p>
							<p class="period">{period}</p>
							{description && <p class="description">{description}</p>}
						</li>
					) : (
						<li>
							<p class="period">{period}</p>
							<div>
								<h3>{slug ? <a href={`/experience/${slug}`}>{role}</a> : role}</h3>
								<p class="where">{[organisation, location].filter(Boolean).join(' · ')}</p>
								{description && <p class="description">{description}</p>}
							</div>
						</li>
					),
				)}
			</ol>
		</section>
	)
}

<style>
	section {
		max-inline-size: var(--content-width);
		margin-inline: auto;
		padding-inline: var(--gutter);
	}

	.cv {
		display: grid;
		gap: var(--space-m);
		padding-block-start: var(--space-l);
	}

	@media (min-width: 56rem) {
		.cv {
			grid-template-columns: 1fr 2fr;
			gap: var(--space-2xl);
		}
	}

	h2 {
		font-family: var(--font-mono);
		font-size: var(--step--2);
		font-weight: 500;
		letter-spacing: var(--tracking-label);
		line-height: var(--leading-body);
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	/* The main Experience section matches the Projects heading; Previous jobs keeps the small label like Education. */
	h2.lead {
		font-family: var(--font-display);
		font-size: var(--step-3);
		font-weight: var(--weight-display);
		letter-spacing: -0.03em;
		line-height: var(--leading-snug);
		text-transform: none;
		color: inherit;
	}

	ol {
		padding: 0;
		list-style: none;
		border-block-start: var(--border-hairline);
	}

	/* Compact timeline (Previous jobs). */
	li {
		display: grid;
		gap: var(--space-3xs);
		padding-block: var(--space-m);
		border-block-end: var(--border-hairline);
		overflow-wrap: anywhere;
	}

	@media (min-width: 40rem) {
		li {
			grid-template-columns: 11rem 1fr;
			column-gap: var(--space-m);
		}
	}

	.period {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--color-text-muted);
	}

	h3 {
		font-size: var(--step-1);
		font-weight: var(--weight-body);
		line-height: var(--leading-snug);
		letter-spacing: -0.01em;
	}

	h3 a {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2xs);
		min-block-size: var(--tap-target);
		text-decoration: none;
		color: inherit;
	}

	h3 a::after {
		content: '→';
		color: var(--color-accent);
		transition: transform var(--duration-base) var(--ease-out);
	}

	h3 a:hover {
		color: var(--color-accent);
	}

	h3 a:hover::after {
		transform: translateX(0.35em);
	}

	.where {
		color: var(--color-text-soft);
	}

	.description {
		max-inline-size: 52ch;
		margin-block-start: var(--space-2xs);
		font-size: var(--step--1);
		line-height: var(--leading-body);
		color: var(--color-text-soft);
	}

	/* Experience: rows follow the Projects list, with the role as the large title and organisation and period as mono labels. */
	.lead li {
		position: relative;
		grid-template-columns: 1fr auto;
		grid-template-areas:
			'title title'
			'where period'
			'description description';
		column-gap: var(--space-m);
		row-gap: var(--space-3xs);
		align-items: baseline;
		transition: padding-inline var(--duration-base) var(--ease-out);
	}

	@media (min-width: 36rem) {
		.lead li {
			grid-template-columns: 1fr minmax(8rem, auto) auto;
			grid-template-areas:
				'title where period'
				'description description description';
		}
	}

	.lead h3 {
		grid-area: title;
		font-size: var(--step-1);
		font-weight: var(--weight-display);
		letter-spacing: -0.02em;
		text-wrap: balance;
		transition: color var(--duration-fast) var(--ease-out);
	}

	@media (min-width: 36rem) {
		.lead h3 {
			font-size: var(--step-2);
		}
	}

	/* The whole row is the link target. */
	.lead h3 a {
		display: inline;
		min-block-size: 0;
	}

	.lead h3 a::before {
		content: '';
		position: absolute;
		inset: 0;
	}

	.lead h3 a::after {
		content: none;
	}

	.lead li:has(h3 a):is(:hover, :focus-within) {
		padding-inline: var(--space-s);
		background: var(--color-surface);
	}

	.lead li:has(h3 a):is(:hover, :focus-within) h3 {
		color: var(--color-accent);
	}

	.lead .where,
	.lead .period {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		letter-spacing: var(--tracking-label);
		text-transform: uppercase;
		color: var(--color-text-muted);
	}

	.lead .where {
		grid-area: where;
	}

	.lead .period {
		grid-area: period;
		text-align: end;
		white-space: nowrap;
	}

	.lead .description {
		grid-area: description;
	}
</style>
