---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import ExperienceDetail from '../../components/ExperienceDetail/ExperienceDetail.astro';
import { getExperience, getExperiences, getSiteSettings } from '../../utils/sanity';

export const getStaticPaths = (async () => {
	const summaries = await getExperiences();
	const pages = await Promise.all(summaries.map(({ slug }) => getExperience(slug)));
	return pages.flatMap((experience) =>
		experience ? [{ params: { slug: experience.slug }, props: { experience } }] : [],
	);
}) satisfies GetStaticPaths;

const { experience } = Astro.props;
const { name } = await getSiteSettings();
---

<Base
	title={`${experience.role}, ${experience.organisation} · ${name}`}
	description={experience.description ?? `${experience.role}, ${experience.organisation}. ${experience.period}.`}
>
	<ExperienceDetail experience={experience} />
</Base>
